# Normalize line endings to LF for Python/JS/TS files.
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf

# Binary / generated — keep as-is.
*.db        binary
*.png       binary
*.svg       binary
*.ico       binary
