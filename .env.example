# ProcuGents Environment Variables
# Get your free API key at https://opencode.ai/settings/api-keys

# ── AI Analysis ──────────────────────────────────────────────────────
# Required for LLM-powered deep analysis (optional — rule-based fallback)
OPENCODE_API_KEY=

# Optional fallback providers (used when OpenCode is unavailable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — Exa API for real-time market-price lookups
# Used by the price_analysis_node when Redis cache misses.
# Get a key at https://exa.ai
EXA_API_KEY=

# ── Database ─────────────────────────────────────────────────────────
# PostgreSQL connection (defaults to local SQLite ``procugents.db``
# when POSTGRES_PASSWORD is empty/not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=redflag_agents

# ── Cache ────────────────────────────────────────────────────────────
# Redis connection (defaults to localhost when unset)
REDIS_URL=redis://localhost:6379

# ── PhilGEPS Scraper ─────────────────────────────────────────────────
# Set to "1" / "true" to enable live HTTPS scraping of the legacy
# PhilGEPS notices page (notices.philgeps.gov.ph).
# When unset or "false" the mock client is used (deterministic fixtures).
PHILGEPS_LIVE=

# Path to a Netscape-format cookie jar exported from a browser session
# with a PhilGEPS Platinum account. Optional — unlocks more detail pages.
PHILGEPS_COOKIE_FILE=

# ── Frontend (Next.js) ──────────────────────────────────────────────
# Base URL of the FastAPI backend. Used by Next.js server-side API
# route proxies.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for live dashboard alerts (used client-side in the
# browser). When omitted the dashboard derives it from the page origin.
NEXT_PUBLIC_WS_URL=ws://localhost:8000